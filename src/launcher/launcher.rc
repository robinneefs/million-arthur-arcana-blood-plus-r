// Build 120: launcher icon + file details
#include <winver.h>
#include "../mod/version.h"
1 VERSIONINFO
FILEVERSION MOD_VER_RC
PRODUCTVERSION MOD_VER_RC
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "GGenie (fan-made, open source)"
      VALUE "FileDescription", "Arcana Blood +R launcher (updates the mod and starts the game with it)"
      VALUE "FileVersion", MOD_VERSION
      VALUE "InternalName", "arcana_launcher"
      VALUE "OriginalFilename", "arcana_launcher.exe"
      VALUE "ProductName", "Arcana Blood +R"
      VALUE "ProductVersion", MOD_VERSION
      VALUE "LegalCopyright", "MIT licence. github.com/robinneefs/million-arthur-arcana-blood-plus-r"
      VALUE "Comments", "Fan-made rollback netcode mod for Million Arthur: Arcana Blood. Not affiliated with Square Enix or Team Arcana."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
1 ICON "../../assets/icon/arcana_plusr.ico"
// Build 120b: tells Windows the launcher runs as the user (no admin prompt)
1 24 "launcher.manifest"
